      }
    }
  ],
  "randomness": {
    "engine": "python.random.Random",
    "seed_derivation": "int.from_bytes(sha256(f\"{base_seed}|{scenario}|{stream}\".encode(\"utf-8\")).digest()[:8], \"big\")",
